# ============ LLM 服务 ============
# 复制本文件为 .env 并填入真实密钥
OPENAI_API_KEY=sk-your-key-here
# OpenAI 官方:
OPENAI_BASE_URL=https://api.openai.com/v1
# 阿里云百炼(兼容模式)示例:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen3.7-plus

# ============ 运行参数 ============
MAX_OUTPUT_TOKENS=8000
CONTEXT_BUDGET_TOKENS=32000
STREAM=true
TEMPERATURE=0.0
MAX_ITERATIONS=50
RETRY_MAX=4
RETRY_BASE_DELAY=1.0

# ============ 记忆 ============
MEMORY_KEEP_TURNS=3

# ============ 沙箱 / 工具 ============
# 所有文件操作被限制在 WORKSPACE 内
# WORKSPACE=D:\study\LLM API\harness\workspace
TOOL_OUTPUT_MAX_CHARS=5000

# ============ 日志 ============
ENABLE_AUDIT=true
