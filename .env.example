# ============ LLM 服务 ============
# 复制本文件为 .env 并填入真实密钥
OPENAI_API_KEY=sk-your-key-here
# OpenAI 官方:
OPENAI_BASE_URL=https://api.openai.com/v1
# 阿里云百炼(兼容模式)示例:
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL=qwen3.7-plus

# ============ 运行参数 ============
MAX_OUTPUT_TOKENS=8000
CONTEXT_BUDGET_TOKENS=32000
STREAM=true
TEMPERATURE=0.0
MAX_ITERATIONS=50
RETRY_MAX=4
RETRY_BASE_DELAY=1.0
LLM_TIMEOUT=120
MAX_RUN_SECONDS=300
# 0 表示不限制；生产建议设置正数
MAX_TOTAL_TOKENS=50000

# ============ 记忆 ============
MEMORY_KEEP_TURNS=3

# ============ 沙箱 / 工具 ============
# 所有文件操作被限制在 WORKSPACE 内
# WORKSPACE=/srv/harness/workspace
TOOL_OUTPUT_MAX_CHARS=5000
# 默认关闭任意命令执行；仅在隔离容器内显式开启
ENABLE_BASH=false
MAX_BASH_TIMEOUT=30

# ============ API 服务 ============
ENVIRONMENT=development
# 生产环境启动时要求 API_AUTH_TOKEN 非空
# 生产环境必须设置；留空表示不启用鉴权（仅适合本机开发）
API_AUTH_TOKEN=
# 可选：容器/生产环境显式指定数据和日志路径
# DATA_DIR=/var/lib/harness
# MEMORY_FILE=/var/lib/harness/memory.json
# LOG_DIR=/var/log/harness
# Redis 会话存储
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=harness:session:
SESSION_TTL=86400
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_REQUESTS=16

# ============ 日志 ============
ENABLE_AUDIT=true
